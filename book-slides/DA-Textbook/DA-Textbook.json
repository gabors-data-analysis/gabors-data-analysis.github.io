      "id": "teaching",
      "hidden": false,
      "layout": "auto",
      "background": null,
      "header": "",
      "aside": "",
      "speaker": "The book is written for self-study, which frees contact time. Multiple choice questions from the publisher work as start-of-class quizzes.",
      "print": "",
      "steps": 0,
      "blocks": [
        {
          "type": "title",
          "content": "Three teaching habits that worked for us",
          "step": 0
        },
        {
          "type": "list",
          "ordered": true,
          "size": "normal",
          "items": [
            {
              "content": "**Assign reading in advance.** Run a short quiz at the start, then spend class on questions and case studies.",
              "number": 1
            },
            {
              "content": "**Run code in class.** Students like seeing the sausage in the making, and then tinker on their own.",
              "number": 2
            },
            {
              "content": "**Make students replicate.** Each chapter ends with data exercises. Start from the case study code, change one thing.",
              "number": 3
            }
          ],
          "step": 0,
          "start": 1,
          "progressive": false
        }
      ]
    },
